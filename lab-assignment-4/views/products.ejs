<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Catalog</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        body {
            background: #fbf2e8;
        }

        .products-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            background: #fcf5ea;
            border-radius: 16px;
        }

        .products-page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #ddd;
        }

        .products-page-header .ideas-logo {
            height: 42px;
            flex-shrink: 0;
        }

        .products-page-header a {
            margin-right: 12px;
            text-decoration: none;
            color: #111;
            font-weight: 700;
        }

        .products-page-header a:hover {
            color: #b5702d;
        }

        .user-nav {
            margin-left: auto;
            display: flex;
            gap: 12px;
        }

        .user-nav a {
            padding: 8px 14px;
            background: #0f172a;
            color: white;
            border-radius: 6px;
            margin: 0;
        }

        .user-nav a:hover {
            background: #1e293b;
            color: white;
        }

        .filters {
            background: #f8efe0;
            padding: 24px;
            border-radius: 12px;
            margin-bottom: 30px;
            border: 1px solid #e8d8c5;
        }

        .filters form {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            align-items: end;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
        }

        .filter-group label {
            margin-bottom: 5px;
            font-weight: bold;
        }

        .filter-group input,
        .filter-group select {
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 4px;
            min-width: 150px;
        }

        .filter-group input[type="number"] {
            width: 100px;
        }

        .btn {
            padding: 10px 18px;
            background: #1b1b1b;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background 0.2s ease;
            text-decoration: none;
        }

        .btn:hover {
            background: #3d2d20;
        }

        .btn.clear {
            background: #8a7f75;
        }

        .btn.clear:hover {
            background: #6b5f57;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .product-card {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            transition: transform 0.2s;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .product-image {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-radius: 8px;
            display: block;
            background: #f5f5f5;
            transition: opacity 0.3s ease;
        }

        .product-image.loading {
            opacity: 0.5;
        }

        .product-image.loaded {
            opacity: 1;
        }

        .product-name {
            font-weight: bold;
            margin-bottom: 5px;
        }

        .product-price {
            color: #28a745;
            font-size: 1.2em;
            margin-bottom: 5px;
        }

        .product-rating {
            color: #ffc107;
            margin-bottom: 5px;
        }

        .product-stock {
            font-size: 0.9em;
            color: #6c757d;
        }

        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            margin-top: 30px;
        }

        .pagination a,
        .pagination span {
            padding: 8px 12px;
            text-decoration: none;
            border: 1px solid #b5702d;
            border-radius: 4px;
            color: #b5702d;
            background: #fff7f0;
        }

        .pagination a:hover {
            background: #b5702d;
            color: white;
        }

        .pagination .current {
            background: #b5702d;
            color: white;
            border-color: #b5702d;
        }

        .pagination .disabled {
            color: #6c757d;
            cursor: not-allowed;
        }

        .no-products {
            text-align: center;
            padding: 50px;
            color: #6c757d;
        }
    </style>
</head>
<body>
    <div class="products-container">
        <header class="products-page-header">
            <img class="ideas-logo" src="/ideasLogo.svg" alt="Ideas logo">
            <div>
                <a class="home-link" href="/">HOME</a>
                <a class="catalog-link" href="/products">PRODUCT CATALOG</a>
            </div>
            <div class="current-category">
                <% if (filters.category && filters.category !== 'all') { %>
                    <span>Category: <strong><%= filters.category %></strong></span>
                <% } %>
            </div>
            <nav class="user-nav">
                <% if (user) { %>
                    <a href="/profile">My Profile</a>
                    <a href="/auth/logout">Logout</a>
                <% } else { %>
                    <a href="/auth/login">Login</a>
                    <a href="/auth/register">Register</a>
                <% } %>
            </nav>
        </header>
        <% if (success && success.length) { %>
            <div style="background:#ecfccb;color:#166534;padding:12px;border-radius:8px;margin-bottom:16px;">
                <%= success[0] %>
            </div>
        <% } %>
        <% if (error && error.length) { %>
            <div style="background:#fee2e2;color:#b91c1c;padding:12px;border-radius:8px;margin-bottom:16px;">
                <%= error[0] %>
            </div>
        <% } %>
        <h1>Product Catalog</h1>

        <!-- Filters and Search -->
        <div class="filters">
            <form method="GET" action="/products">
                <div class="filter-group">
                    <label for="search">Search Products:</label>
                    <input type="text" id="search" name="search" value="<%= filters.search %>" placeholder="Search by name...">
                </div>

                <div class="filter-group">
                    <label for="category">Category:</label>
                    <select id="category" name="category">
                        <option value="all">All Categories</option>
                        <% categories.forEach(category => { %>
                            <option value="<%= category %>" <%= filters.category === category ? 'selected' : '' %>><%= category %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="filter-group">
                    <label for="minPrice">Min Price:</label>
                    <input type="number" id="minPrice" name="minPrice" value="<%= filters.minPrice %>" step="0.01" min="0">
                </div>

                <div class="filter-group">
                    <label for="maxPrice">Max Price:</label>
                    <input type="number" id="maxPrice" name="maxPrice" value="<%= filters.maxPrice %>" step="0.01" min="0">
                </div>

                <div class="filter-group">
                    <label for="sort">Sort By:</label>
                    <select id="sort" name="sort">
                        <option value="">Default</option>
                        <option value="name_asc" <%= filters.sort === 'name_asc' ? 'selected' : '' %>>Name (A-Z)</option>
                        <option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>>Price (Low to High)</option>
                        <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Price (High to Low)</option>
                        <option value="rating_desc" <%= filters.sort === 'rating_desc' ? 'selected' : '' %>>Rating (High to Low)</option>
                    </select>
                </div>

                <button type="submit" class="btn">Apply Filters</button>
                <a href="/products" class="btn clear">Clear Filters</a>
            </form>
        </div>

        <!-- Products Grid -->
        <% if (products.length > 0) { %>
            <div class="products-grid">
                <% products.forEach(product => { %>
                    <div class="product-card">
                        <img
                          src="<%= product.image %>"
                          alt="<%= product.name %>"
                          class="product-image"
                          loading="lazy"
                          onerror="handleImageError(this)"
                          onload="handleImageLoad(this)"
                        />
                        <div class="product-name"><%= product.name %></div>
                        <div class="product-price">$<%= product.price.toFixed(2) %></div>
                        <div class="product-rating">
                            <% for (let i = 1; i <= 5; i++) { %>
                                <% if (i <= Math.floor(product.rating)) { %>
                                    ★
                                <% } else if (i - 0.5 <= product.rating) { %>
                                    ☆
                                <% } else { %>
                                    ☆
                                <% } %>
                            <% } %>
                            (<%= product.rating %>)
                        </div>
                        <div class="product-stock">Stock: <%= product.stock %></div>
                        <div style="margin-top: 10px;">
                            <small style="color: #6c757d;"><%= product.category %></small>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="no-products">
                <h3>No products found</h3>
                <p>Try adjusting your filters or search terms.</p>
            </div>
        <% } %>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
            <div class="pagination">
                <% if (currentPage > 1) { %>
                    <a href="?<%= new URLSearchParams({...filters, page: currentPage - 1}).toString() %>">Previous</a>
                <% } else { %>
                    <span class="disabled">Previous</span>
                <% } %>

                <% for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) { %>
                    <% if (i === currentPage) { %>
                        <span class="current"><%= i %></span>
                    <% } else { %>
                        <a href="?<%= new URLSearchParams({...filters, page: i}).toString() %>"><%= i %></a>
                    <% } %>
                <% } %>

                <% if (currentPage < totalPages) { %>
                    <a href="?<%= new URLSearchParams({...filters, page: currentPage + 1}).toString() %>">Next</a>
                <% } else { %>
                    <span class="disabled">Next</span>
                <% } %>
            </div>
        <% } %>

        <div style="text-align: center; margin-top: 20px;">
            <p>Showing <%= products.length %> of <%= totalProducts %> products</p>
            <a href="/" style="color: #007bff; text-decoration: none;">← Back to Home</a>
        </div>
    </div>

    <script>
        // Prevent infinite image reload loops and handle loading states
        function handleImageError(img) {
            // Prevent infinite error loops
            if (img.src.includes('placeholder.jpg')) {
                return; // Already showing placeholder
            }

            // Set to placeholder and mark as loaded to prevent further attempts
            img.src = '/placeholder.jpg';
            img.classList.remove('loading');
            img.classList.add('loaded');
            console.log('Image failed to load for:', img.alt);
        }

        function handleImageLoad(img) {
            // Mark image as loaded
            img.classList.remove('loading');
            img.classList.add('loaded');
        }

        // Add loading class to all images initially
        document.addEventListener('DOMContentLoaded', function() {
            const images = document.querySelectorAll('.product-image');
            images.forEach(img => {
                img.classList.add('loading');
            });
        });

        // Prevent layout shift by setting image dimensions immediately
        document.addEventListener('DOMContentLoaded', function() {
            const images = document.querySelectorAll('.product-image');
            images.forEach(img => {
                // Ensure consistent dimensions
                img.style.width = '100%';
                img.style.height = '220px';
            });
        });
    </script>
</body>
</html>