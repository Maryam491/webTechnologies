<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
    <style>
        html,
        body {
            min-height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            background: #f7f3ee;
            font-family: Arial, sans-serif;
        }

        .admin-shell {
            display: flex;
            min-height: 100vh;
            overflow: hidden;
        }

        .admin-sidebar {
            width: 240px;
            background: #0a0f15;
            color: #f8fafc;
            padding: 24px 16px;
            box-shadow: 2px 0 12px rgba(0,0,0,0.08);
            position: sticky;
            top: 0;
            height: 100vh;
            overflow: auto;
        }

        .admin-brand {
            font-size: 1.4rem;
            font-weight: 700;
            margin-bottom: 28px;
        }

        .admin-brand a {
            text-decoration: none;
            color: #f8fafc;
        }

        .admin-nav {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .admin-nav a {
            color: #cbd5e1;
            text-decoration: none;
            padding: 12px 14px;
            border-radius: 8px;
            transition: background 0.2s ease;
        }

        .admin-nav a.active,
        .admin-nav a:hover {
            background: #334155;
            color: #fff;
        }

        .logout-link {
            margin-top: 20px;
            background: #dc2626;
            color: white;
            display: inline-block;
            text-align: center;
        }

        .admin-main {
            flex: 1;
            padding: 28px 32px;
            overflow-y: auto;
            max-height: 100vh;
        }

        .admin-header {
            margin-bottom: 24px;
        }

        .admin-table .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 8px 14px;
            border-radius: 10px;
            border: none;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
        }

        .admin-header {
            margin-bottom: 24px;
            text-align: center;
            background: transparent;
            position: static;
        }

        .admin-table .btn.edit-btn {
            background: #2563eb;
            color: white;
        }

        .admin-table .btn.delete-btn {
            background: #dc2626;
            color: white;
        }

        .admin-header h1 {
            margin: 0;
            font-size: 2rem;
            color: #111827;
        }
    </style>
</head>
<body>
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <div class="admin-brand"><a href="/admin/dashboard">Admin Panel</a></div>
            <nav class="admin-nav">
                <a href="/admin/dashboard" class="<%= active === 'dashboard' ? 'active' : '' %>">Dashboard</a>
                <a href="/">Home</a>
                <a href="/admin/products/new" class="<%= active === 'new' ? 'active' : '' %>">Create Product</a>
                <a href="/admin/logout" class="logout-link">Logout</a>
            </nav>
        </aside>
        <main class="admin-main"> 
            <header class="admin-header">
                <h1><%= title %></h1>
            </header>
                <% if (success && success.length) { %>
                    <div style="background:#ecfccb;color:#166534;padding:12px;border-radius:8px;margin-bottom:16px;">
                        <%= success[0] %>
                    </div>
                <% } %>
                <% if (error && error.length) { %>
                    <div style="background:#fee2e2;color:#991b1b;padding:12px;border-radius:8px;margin-bottom:16px;">
                        <%= error[0] %>
                    </div>
                <% } %>
