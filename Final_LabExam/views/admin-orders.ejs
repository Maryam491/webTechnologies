<%- include('admin-header', { active: 'orders', title: 'Admin Orders' }) %>

<style>
    .admin-content {
        background: white;
        padding: 20px;
        border-radius: 8px;
        margin: 20px;
    }
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }
    .stat-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 20px;
        border-radius: 8px;
        text-align: center;
    }
    .stat-card h3 {
        margin: 0 0 10px 0;
        font-size: 0.9em;
        opacity: 0.9;
    }
    .stat-card .value {
        font-size: 2em;
        font-weight: bold;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }
    th {
        background: #f5f5f5;
        padding: 12px;
        text-align: left;
        border: 1px solid #ddd;
        font-weight: bold;
    }
    td {
        padding: 12px;
        border: 1px solid #ddd;
    }
    tr:hover {
        background: #f9f9f9;
    }
    .status-badge {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.85em;
        font-weight: bold;
    }
    .status-pending {
        background: #fff3cd;
        color: #856404;
    }
    .status-confirmed {
        background: #d1ecf1;
        color: #0c5460;
    }
    .status-shipped {
        background: #cfe2ff;
        color: #084298;
    }
    .status-delivered {
        background: #d1e7dd;
        color: #0f5132;
    }
    .order-items-btn {
        padding: 6px 12px;
        background: #2563eb;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.9em;
    }
    .order-items-btn:hover {
        background: #1d4ed8;
    }
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.4);
    }
    .modal.show {
        display: block;
    }
    .modal-content {
        background-color: #fefefe;
        margin: 5% auto;
        padding: 20px;
        border: 1px solid #888;
        border-radius: 8px;
        width: 90%;
        max-width: 600px;
    }
    .close-modal {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
    }
    .close-modal:hover {
        color: black;
    }
    .item-list {
        list-style: none;
        padding: 0;
        margin: 15px 0;
    }
    .item-list li {
        padding: 8px;
        border-bottom: 1px solid #ddd;
        display: flex;
        justify-content: space-between;
    }
    .item-list li:last-child {
        border-bottom: none;
    }
</style>

<div class="admin-content">
    <h2 style="margin-top: 0;">All Orders</h2>
    
    <div class="stats-grid">
        <div class="stat-card">
            <h3>Total Orders</h3>
            <div class="value"><%= orders.length %></div>
        </div>
        <div class="stat-card" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
            <h3>Pending</h3>
            <div class="value"><%= orders.filter(o => o.status === 'pending').length %></div>
        </div>
        <div class="stat-card" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
            <h3>Delivered</h3>
            <div class="value"><%= orders.filter(o => o.status === 'delivered').length %></div>
        </div>
    </div>

    <% if (orders.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Items</th>
                </tr>
            </thead>
            <tbody>
                <% orders.forEach(order => { %>
                    <tr>
                        <td><strong>#<%= order._id.toString().substr(-8).toUpperCase() %></strong></td>
                        <td>
                            <%= order.user.name %><br>
                            <small style="color: #666;"><%= order.user.email %></small>
                        </td>
                        <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                        <td><strong>$<%= order.total.toFixed(2) %></strong></td>
                        <td>
                            <span class="status-badge status-<%= order.status %>">
                                <%= order.status.toUpperCase() %>
                            </span>
                        </td>
                        <td>
                            <button class="order-items-btn" onclick="showOrderItems('<%= order._id %>', <%= JSON.stringify(order.items).replace(/'/g, '&#39;') %>)">
                                View Items (<%= order.items.length %>)
                            </button>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } else { %>
        <div style="text-align: center; padding: 50px; color: #6c757d;">
            <h3>No orders found</h3>
            <p>No orders have been placed yet.</p>
        </div>
    <% } %>
</div>

<div id="itemsModal" class="modal">
    <div class="modal-content">
        <span class="close-modal" onclick="closeModal()">&times;</span>
        <h3>Order Items</h3>
        <ul class="item-list" id="itemsList"></ul>
        <div style="text-align: right; font-size: 1.1em; font-weight: bold; color: #d63384; margin-top: 15px;">
            Total: $<span id="itemsTotal">0.00</span>
        </div>
    </div>
</div>

<script>
function showOrderItems(orderId, items) {
    const itemsList = document.getElementById('itemsList');
    const itemsTotal = document.getElementById('itemsTotal');
    
    itemsList.innerHTML = '';
    let total = 0;
    
    items.forEach(item => {
        const li = document.createElement('li');
        const subtotal = item.price * item.quantity;
        total += subtotal;
        li.innerHTML = `
            <span>${item.name} (×${item.quantity})</span>
            <span>$${subtotal.toFixed(2)}</span>
        `;
        itemsList.appendChild(li);
    });
    
    itemsTotal.textContent = total.toFixed(2);
    document.getElementById('itemsModal').classList.add('show');
}

function closeModal() {
    document.getElementById('itemsModal').classList.remove('show');
}

window.onclick = function(event) {
    const modal = document.getElementById('itemsModal');
    if (event.target === modal) {
        modal.classList.remove('show');
    }
};
</script>

<%- include('admin-footer') %>
