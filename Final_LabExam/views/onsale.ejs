<style>
    body {
        background: #fbf2e8;
    }
    .onsale-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
        background: #fcf5ea;
        border-radius: 16px;
    }
    .page-header {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #ddd;
        }
        .page-header a {
            margin-right: 12px;
            text-decoration: none;
            color: #111;
            font-weight: 700;
        }
        .page-header a:hover {
            color: #b5702d;
        }
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }
        .product-card {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            transition: transform 0.2s;
        }
        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        .product-image {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-radius: 8px;
            display: block;
            background: #f5f5f5;
            transition: opacity 0.3s ease;
        }
        .product-name {
            font-weight: bold;
            margin: 12px 0 8px;
        }
        .product-price {
            color: #d63384;
            font-size: 1.2em;
            margin-bottom: 8px;
        }
        .product-rating {
            color: #ffc107;
            margin-bottom: 8px;
        }
        .product-stock {
            font-size: 0.95em;
            color: #6c757d;
        }
        .pagination-controls {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            margin: 24px 0 10px;
        }
        .pagination-controls button {
            padding: 10px 18px;
            border: 1px solid #b5702d;
            border-radius: 6px;
            background: #fff7f0;
            color: #b5702d;
            cursor: pointer;
            font-weight: 700;
        }
        .pagination-page-btn {
            min-width: 42px;
            padding: 8px 14px;
            border: 1px solid #b5702d;
            border-radius: 6px;
            background: #fff7f0;
            color: #b5702d;
            cursor: pointer;
            font-weight: 700;
        }
        .pagination-page-btn.active {
            background: #b5702d;
            color: #fff;
        }
        .pagination-controls button:disabled,
        .pagination-page-btn:disabled {
            opacity: 0.35;
            cursor: not-allowed;
        }
        .page-indicator {
            font-size: 1rem;
            color: #444;
            font-weight: 600;
        }
        .pagination-link {
            padding: 10px 18px;
            border: 1px solid #b5702d;
            border-radius: 6px;
            background: #fff7f0;
            color: #b5702d;
            text-decoration: none;
            font-weight: 700;
        }
        .pagination-link.disabled,
        .pagination-link.disabled:hover {
            opacity: 0.35;
            cursor: not-allowed;
            pointer-events: none;
            color: #8b5e2b;
        }
        .pagination-page-btn {
            min-width: 42px;
            padding: 8px 14px;
            border: 1px solid #b5702d;
            border-radius: 6px;
            background: #fff7f0;
            color: #b5702d;
            text-decoration: none;
            cursor: pointer;
            font-weight: 700;
        }
        .pagination-page-btn.active {
            background: #b5702d;
            color: #fff;
        }
        .no-products {
            text-align: center;
            padding: 50px;
            color: #6c757d;
        }
    </style>
    <div class="onsale-container">
        <header class="page-header">
            <div>
                <a href="/">HOME</a>
                <a href="/products">PRODUCT CATALOG</a>
            </div>
            <h1>On Sale Products</h1>
            <div>
                <a href="/onsale-products">Refresh</a>
            </div>
        </header>

        <% if (products.length > 0) { %>
            <p style="margin-bottom: 20px; color: #444; font-weight: 600;">
                Showing page <%= page %> of <%= totalPages %> for <%= totalProducts %> sale items.
            </p>
            <div id="product-list" class="products-grid">
                <% products.forEach(product => { %>
                    <div class="product-card onsale-card">
                        <img
                          src="<%= product.image %>"
                          alt="<%= product.name %>"
                          class="product-image"
                          loading="lazy"
                          onerror="handleImageError(this)"
                          onload="handleImageLoad(this)"
                        />
                        <div class="product-name"><%= product.name %></div>
                        <div class="product-price">$<%= product.price.toFixed(2) %></div>
                        <div class="product-rating">
                            <% for (let i = 1; i <= 5; i++) { %>
                                <% if (i <= Math.floor(product.rating)) { %>
                                    ★
                                <% } else { %>
                                    ☆
                                <% } %>
                            <% } %>
                            (<%= product.rating %>)
                        </div>
                        <div class="product-stock">Stock: <%= product.stock %></div>
                        <div style="margin-top: 10px; color: #6c757d;"><%= product.category %></div>
                        <form method="POST" action="/cart/add" style="margin-top: 12px;">
                            <input type="hidden" name="productId" value="<%= product._id %>">
                            <input type="hidden" name="quantity" value="1">
                            <button type="submit" style="width: 100%; padding: 8px; background: #d63384; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 700;">Add to Cart</button>
                        </form>
                    </div>
                <% }); %>
            </div>

            <div class="pagination-controls">
                <a href="/onsale-products?page=<%= page - 1 %>" class="pagination-link <%= page <= 1 ? 'disabled' : '' %>">Previous</a>
                <% for (let p = 1; p <= totalPages; p++) { %>
                    <a href="/onsale-products?page=<%= p %>" class="pagination-page-btn <%= p === page ? 'active' : '' %>"><%= p %></a>
                <% } %>
                <a href="/onsale-products?page=<%= page + 1 %>" class="pagination-link <%= page >= totalPages ? 'disabled' : '' %>">Next</a>
            </div>
        <% } else { %>
            <div class="no-products">
                <h2>No promotional items are available right now.</h2>
                <p>Check back later or browse the full product catalog.</p>
            </div>
        <% } %>
    </div>

    <script>
        function handleImageError(img) {
            if (img.src.includes('placeholder.jpg')) return;
            img.src = '/placeholder.jpg';
            img.classList.remove('loading');
            img.classList.add('loaded');
        }

        function handleImageLoad(img) {
            img.classList.remove('loading');
            img.classList.add('loaded');
        }
    </script>
