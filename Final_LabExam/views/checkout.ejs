<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        body {
            background: #fbf2e8;
        }
        .checkout-container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 20px;
            background: #fcf5ea;
            border-radius: 16px;
        }
        .page-header {
            margin-bottom: 30px;
            padding-bottom: 10px;
            border-bottom: 1px solid #ddd;
        }
        .checkout-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }
        .form-section {
            background: #f8efe0;
            padding: 20px;
            border-radius: 8px;
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }
        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 1em;
        }
        .order-summary {
            background: #f8efe0;
            padding: 20px;
            border-radius: 8px;
        }
        .summary-item {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #ddd;
        }
        .summary-item:last-child {
            border-bottom: none;
        }
        .summary-total {
            display: flex;
            justify-content: space-between;
            padding: 15px 0;
            font-size: 1.2em;
            font-weight: bold;
            color: #d63384;
        }
        .place-order-btn {
            width: 100%;
            padding: 12px;
            background: #1b1b1b;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 1em;
            margin-top: 20px;
        }
        .place-order-btn:hover {
            background: #3d2d20;
        }
        .back-link {
            display: inline-block;
            margin-top: 20px;
            color: #007bff;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <div class="checkout-container">
        <header class="page-header">
            <h1>Checkout</h1>
        </header>

        <% if (error && error.length) { %>
            <div style="background:#fee2e2;color:#b91c1c;padding:12px;border-radius:8px;margin-bottom:16px;">
                <%= error[0] %>
            </div>
        <% } %>

        <div class="checkout-content">
            <div class="form-section">
                <h2>Delivery Information</h2>
                <form method="POST" action="/place-order">
                    <div class="form-group">
                        <label for="address">Delivery Address *</label>
                        <textarea id="address" name="address" rows="4" required placeholder="Enter your full address"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="phone">Phone Number *</label>
                        <input type="tel" id="phone" name="phone" required placeholder="Enter your phone number">
                    </div>
                    <button type="submit" class="place-order-btn">Place Order</button>
                </form>
            </div>

            <div class="order-summary">
                <h2>Order Summary</h2>
                <% cart.forEach(item => { %>
                    <div class="summary-item">
                        <span><%= item.name %> (×<%= item.quantity %>)</span>
                        <span>$<%= (item.price * item.quantity).toFixed(2) %></span>
                    </div>
                <% }); %>
                <div class="summary-total">
                    <span>Total Amount:</span>
                    <span>$<%= total.toFixed(2) %></span>
                </div>
            </div>
        </div>

        <a href="/cart" class="back-link">← Back to Cart</a>
    </div>
</body>
</html>
